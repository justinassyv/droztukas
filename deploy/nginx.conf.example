server {
    listen 80;
    listen [::]:80;
    server_name drozk.lt www.drozk.lt;

    # certbot will rewrite this to redirect to HTTPS once you run it
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    client_max_body_size 64k;
    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
}

# certbot adds a separate "listen 443 ssl" server block — add the HSTS header there,
# not in the port-80 block, since the header must only ever be sent over HTTPS.
# server {
#     listen 443 ssl;
#     ...
#     add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
# }
