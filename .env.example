# Server
PORT=3000
HOST=0.0.0.0

# Where to email new order notifications. If unset, orders are saved to orders.json only.
NOTIFY_EMAIL=info@drozk.lt

# SMTP — leave blank to disable email. Tested with any standard SMTP provider
# (Mailgun, Postmark, SendGrid, your own postfix, Gmail with app password, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Drožtukas <no-reply@drozk.lt>"

# Paysera payment gateway
# Get Project ID and Sign password from: paysera.com → My projects → Settings
PAYSERA_PROJECT_ID=
PAYSERA_SIGN_PASSWORD=
# Set to 1 for test mode (no real money), remove or set to 0 in production
PAYSERA_TEST=1
# Public URL of this site (used for callback/redirect URLs sent to Paysera)
SITE_URL=https://drozk.lt

# LP Express (Mano siuntos) — used to fetch the parcel terminal list shown in the order form
# (Login credentials from your LP Express business/API account)
LPEXPRESS_USERNAME=
LPEXPRESS_PASSWORD=
# Set to 1 to use the test environment (api-manosiuntostst.post.lt), 0/unset for production (api-manosiuntos.post.lt)
LPEXPRESS_TEST=0

# Admin dashboard (/admin)
# Generate hash: node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 12))" 'mypassword'
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=
# Generate secret: openssl rand -hex 32
SESSION_SECRET=
# true behind HTTPS (production via Nginx), false for plain http://localhost dev
COOKIE_SECURE=true
